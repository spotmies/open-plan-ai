#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "Running pre-commit checks..."

# 1. Lint staged files
echo "Linting staged files..."
npx lint-staged

# 2. Full type-check
echo "Type checking..."
npm run type-check

# 3. Test suite — catches logic regressions before commit
echo "Running tests..."
npm test

echo "All checks passed!"
