# ============================================================
# Open Plan AI Frontend — Environment Variables
# Copy to .env and fill in values
# ============================================================

# Backend API (Node.js)
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_WS_URL=http://localhost:3001

# App info
VITE_APP_NAME=Open Plan AI
VITE_APP_VERSION=1.0.0

# Feature flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false

# Sentry error monitoring (required in production)
# Get your DSN from https://sentry.io → Project Settings → Client Keys
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# ─── Chat tuning (optional — sensible defaults are built in) ─────────────────
# These control retry/timeout behaviour for the real-time chat feature.
# Override only if you need to tune for slow networks or high-latency deployments.

# How long (ms) to cache a user's chat-access state before re-checking (default 5000)
VITE_CHAT_ACCESS_STATE_CACHE_TTL_MS=5000

# Base delay (ms) between conversation-list refetch retries after a failed load (default 600)
VITE_CHAT_CONVERSATION_REFETCH_BASE_DELAY_MS=600

# Max number of conversation-list refetch retries before giving up (default 1)
VITE_CHAT_CONVERSATION_REFETCH_MAX_RETRIES=1

# Timeout (ms) when looking up a project's linked conversation ID (default 2500)
VITE_CHAT_PROJECT_ID_LOOKUP_TIMEOUT_MS=2500

# Total timeout (ms) for the "start project chat" flow before showing an error (default 6000)
VITE_CHAT_START_PROJECT_TIMEOUT_MS=6000

# Max poll attempts when waiting for a new project conversation to appear (default 2)
VITE_CHAT_START_PROJECT_MAX_ATTEMPTS=2

# Google OAuth 2.0 Credentials (for Google Meet integration)
# Get from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=

